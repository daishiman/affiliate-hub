{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "affiliate-hub",
  // OpenNext の生成物 (.open-next/worker.js) を直接指さず、それを包む入口を指す。
  // 生成物は画面と API (fetch) しか持たず、定期実行 (scheduled) の受け口が無いため。
  // 生成物の作り直しでこの指定が消えることはない (ビルドは既存の設定を上書きしない)。
  "main": "worker-entry.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // --- 定期実行について -----------------------------------------------------
  // 期限 (180 日) を過ぎた画面の写しを消す。時刻は UTC 指定なので、
  // "0 17 * * *" は日本時間の毎日 2:00。利用の少ない時間帯に寄せている。
  //
  // 消し忘れても画面には出ない (読み出し側が期限を見て渡さない) が、
  // それだけだと「180 日で消えます」という説明が置き場の実態と合わなくなる。
  //
  // 手元で試すときは preview 中に /cdn-cgi/handler/scheduled を開く。
  "triggers": {
    "crons": ["0 17 * * *"]
  },

  // --- 環境について ---------------------------------------------------------
  // Wrangler v4 では「トップレベルのバインディングは env に継承されない」。
  // そのため dev / production それぞれに D1・R2 を明示している。
  // ここを書き忘れると、その環境からバインディングが消える (本番を誤って触ることはない)。
  //
  //   ローカル      : pnpm dev / pnpm preview        -> 下のトップレベル定義 (dev リソース)
  //   dev 環境      : pnpm deploy:dev                -> env.dev
  //   本番          : pnpm deploy:prod               -> env.production
  //
  // トップレベルは「ローカル開発用」として dev リソースを指す。
  // 事故ったときに壊れるのが dev 側になるようにするため。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affiliate-hub-db-dev",
      "database_id": "d1d5f90a-2ebb-43d7-89bd-7b920cdbeeba",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "affiliate-hub-assets-dev"
    }
  ],

  "env": {
    // 開発環境: dev ブランチへのマージで自動デプロイされる
    "dev": {
      "name": "affiliate-hub-dev",
      "compatibility_date": "2026-08-16",
      "compatibility_flags": ["nodejs_compat"],
      "triggers": {
        "crons": ["0 17 * * *"]
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "affiliate-hub-db-dev",
          "database_id": "d1d5f90a-2ebb-43d7-89bd-7b920cdbeeba",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "affiliate-hub-assets-dev"
        }
      ]
    },

    // 本番環境: main ブランチへのマージで自動デプロイされる
    "production": {
      "name": "affiliate-hub",
      "compatibility_date": "2026-08-16",
      "compatibility_flags": ["nodejs_compat"],
      "triggers": {
        "crons": ["0 17 * * *"]
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "affiliate-hub-db",
          "database_id": "eb93e950-a8f6-407e-b3aa-372db5d98c38",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "affiliate-hub-assets"
        }
      ]
    }
  }
}
