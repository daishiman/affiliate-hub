{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness/schemas/system-spec-fetched-references.json",
  "title": "system-spec official reference records",
  "type": "object",
  "required": ["references"],
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "retrieved_at",
          "source_url",
          "official_publisher",
          "official_host",
          "latest_checked_at",
          "evidence_ref",
          "evidence_sha256",
          "summary"
        ],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "source_url": {"type": "string", "format": "uri"},
          "official_publisher": {"type": "string", "minLength": 1},
          "official_host": {"type": "string", "minLength": 1},
          "version": {
            "type": ["string", "null"],
            "description": "その出典が説明している対象の版。この repo が依存している版ではない。C08 の鮮度軸が記録値を公式サイトの現行版と突合するため、依存側の版を書くと依存固定が永久 FAIL になる。"
          },
          "last_updated": {
            "type": ["string", "null"],
            "description": "その出典が表明している更新日。取得日を代入してはならない (C13 の取得日代入検査が拒否する)。"
          },
          "freshness_source": {
            "type": "string",
            "enum": [
              "page-declared",
              "http-last-modified",
              "publisher-registry",
              "content-copyright",
              "undeclared"
            ],
            "description": "version/last_updated の値の由来。値だけを見ると出典の表明と取得日代入が同じ強さに見えるため、由来を分けて機械判定できるようにする。取得日と同日の値を許すのは page-declared のみ。"
          },
          "latest_checked_at": {"type": "string", "format": "date-time"},
          "evidence_ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "summary": {"type": "string", "minLength": 1}
        },
        "anyOf": [
          {"required": ["version"]},
          {"required": ["last_updated"]}
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
