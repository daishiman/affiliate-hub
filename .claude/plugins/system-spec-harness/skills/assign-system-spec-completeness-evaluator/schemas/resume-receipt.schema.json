{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/system-spec-harness/resume-receipt.schema.json",
  "title": "digest-bound system-spec resume receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "verdict", "gates", "artifacts", "evaluator", "created_at", "inputs"],
  "properties": {
    "schema_version": {"const": "1.2", "description": "1.2 = 入力インベントリ (inputs) へ束縛された版。1.1 の receipt は inputs を持たないため、この const で明示的に落ちる。**黙って古い契約のまま通さない**"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "sha256"],
      "description": "この receipt が再利用してよいと言っている入力の指紋。**受領書を入力へ束縛する**ための欄 (gap 6)。これが無いと、receipt は『どの版の仕様書に対する PASS か』を名乗れないまま再利用され、入力が変わったあとの PASS が古いまま有効に見え続ける。sha256 は scripts/spec_input_inventory.py の定義で求め、mtime は材料に入れない。再開時はこの値と現状の指紋を突き合わせ、異なるなら再利用せず再評価する。突き合わせは人の心がけではなく再利用の門 (`.claude/plugins/dev-graph/scripts/validate-system-spec-resume.py` の `input_binding_failures`) が数え直して行い、不一致は `receipt-inputs-stale` で落ちる。受領書の `artifacts` は 5 本しか見ていないため、章 (`system-spec/*.md`) の書き換えはこの欄でしか捕まらない。",
      "properties": {
        "file_count": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "version", "entry_point"],
      "properties": {
        "plugin": {"const": "system-spec-harness"},
        "version": {"type": "string", "pattern": "^0\\.[1-9][0-9]*\\.[0-9]+(?:[-+].*)?$"},
        "entry_point": {"const": "assign-system-spec-completeness-evaluator"}
      }
    },
    "verdict": {"const": "PASS"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "source_citation", "evaluator"],
      "properties": {
        "coverage": {"const": "PASS"},
        "source_citation": {"const": "PASS"},
        "evaluator": {"const": "PASS"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system-spec/index.md", "system-spec/00-requirements-definition.md", "system-spec/completeness-report.json", "system-spec/spec-state.json", "system-spec/fetched-references.json"],
      "properties": {
        "system-spec/index.md": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "system-spec/00-requirements-definition.md": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "system-spec/completeness-report.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "system-spec/spec-state.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "system-spec/fetched-references.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "report_sha256", "fork_ledger_path", "session_id"],
      "properties": {
        "report_path": {"const": "system-spec/completeness-report.json"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fork_ledger_path": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1, "not": {"const": "unknown"}}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
