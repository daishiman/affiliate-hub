# 依存関係
node_modules/
.pnp
.pnp.js

# ビルド成果物
dist/
build/
out/
.next/
.output/
.vercel/
.wrangler/
.open-next/

# 環境変数・シークレット
.env
.env.*
!.env.example
*.pem
.dev.vars

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# データの形を変える前に取る控え。中身は本番データそのものなので置いていかない。
.backup/

# テスト・キャッシュ
coverage/
# ミューテーションの作業場と出力。
# 作業場はソースの写しで 27MB あり、実行が中断すると残り続ける。
# 報告書は毎回数MBの生成物なので、正本は docs/product/mutation.md の実測表と
# 夜間ワークフローの成果物（30日保存）に置き、リポジトリには入れない。
.stryker-tmp/
reports/
.cache/
.turbo/
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/

# dev-graph の一時領域（正本は config.json と state/graph.json）
.dev-graph/cache/
.dev-graph/locks/
.dev-graph/tmp/
# node 登録の入力置き場。登録が済めば正本は state/graph.json と tasks/*.md の側にある
.dev-graph/staging/
.dev-graph/state/*.lock
eval-log/
.codex/

# ログイン不要の「静止した写し」。`pnpm run preview:static` が焼く 1 枚で、
# 中身は CSS を丸ごと埋めた 90KB 超の生成物。実物が変われば焼き直すもので、
# 入れておくと差分が毎回まるごと入れ替わり、しかも古い写しが正本の顔で残る。
docs/product/preview/

# エディタ・OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# 認証情報を書いたファイルの取りこぼし防止。
# この名前を使う手順はもう無いが、万一作られてもコミットされないよう残す。
.cf-credentials
