# 依存関係
node_modules/
.pnp
.pnp.js

# ビルド成果物
dist/
build/
out/
.next/
.output/
.vercel/
.wrangler/
.open-next/

# 環境変数・シークレット
.env
.env.*
!.env.example
*.pem
.dev.vars

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# データの形を変える前に取る控え。中身は本番データそのものなので置いていかない。
.backup/

# テスト・キャッシュ
coverage/
# ミューテーションの作業場と出力。
# 作業場はソースの写しで 27MB あり、実行が中断すると残り続ける。
# 報告書は毎回数MBの生成物なので、正本は docs/product/mutation.md の実測表と
# 夜間ワークフローの成果物（30日保存）に置き、リポジトリには入れない。
.stryker-tmp/
reports/
.cache/
.turbo/
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/

# dev-graph の一時領域（正本は config.json と state/graph.json）
.dev-graph/cache/
.dev-graph/locks/
.dev-graph/tmp/
.dev-graph/state/*.lock
eval-log/
.codex/

# エディタ・OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# 認証情報を書いたファイルの取りこぼし防止。
# この名前を使う手順はもう無いが、万一作られてもコミットされないよう残す。
.cf-credentials
