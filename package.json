{
  "name": "affiliate-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "tsx tests/e2e/prepare-preview.mts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:worker": "opennextjs-cloudflare build && node scripts/dedupe-server-chunks.mjs && opennextjs-cloudflare build --skipNextBuild",
    "preview": "pnpm run build:worker && opennextjs-cloudflare preview",
    "preview:static": "tsx --require ./scripts/lib/css-module-hook.cjs scripts/write-static-preview.tsx",
    "visual": "tsx --require ./scripts/lib/css-module-hook.cjs scripts/visual-regression.tsx",
    "scaffold:blog": "tsx scripts/scaffold-blog-components.ts",
    "deploy:dev": "pnpm run build:worker && opennextjs-cloudflare deploy -- --env dev",
    "deploy:prod": "pnpm run build:worker && opennextjs-cloudflare deploy -- --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --env dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "catalog:sync": "node scripts/catalog-sync.mjs",
    "acceptance:reconcile": "node scripts/acceptance-reconciliation.mjs",
    "verify": "node scripts/verify.mjs",
    "mutation": "stryker run",
    "mutation:changed": "stryker run --since=origin/dev"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "qs": "6.15.3"
    }
  },
  "packageManager": "pnpm@10.19.0"
}
